# Copy this file to .env for local development only.
# Never commit real cookies, JWT secrets, or database URLs.

# Netease VIP cookie. Store the real value in Zeabur environment variables.
VIP_COOKIE=MUSIC_U=your_cookie_here

# Strong random JWT signing secret, at least 32 characters.
JWT_SECRET=replace_with_a_strong_random_secret

FRONTEND_ORIGINS=https://ne0n.zeabur.app
